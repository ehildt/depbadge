{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/depbadge.schema.json",
  "title": "DepbadgeRC",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "dependencies"],

  "properties": {
    "integrity": { "type": "string" },
    "target": { "type": "string" },
    "manifest": { "enum": ["package.json", "pyproject.toml", "Cargo.toml"] },

    "output": {
      "type": "array",
      "items": { "$ref": "#/$defs/OutputFormat" },
      "uniqueItems": true
    },

    "dependenciesLayout": { "$ref": "#/$defs/Layout" },
    "devDependenciesLayout": { "$ref": "#/$defs/Layout" },
    "peerDependenciesLayout": { "$ref": "#/$defs/Layout" },
    "statusBadgesLayout": { "$ref": "#/$defs/Layout" },

    "dependenciesStyle": { "$ref": "#/$defs/BadgeStyle" },
    "devDependenciesStyle": { "$ref": "#/$defs/BadgeStyle" },
    "peerDependenciesStyle": { "$ref": "#/$defs/BadgeStyle" },
    "statusBadgesStyle": { "$ref": "#/$defs/BadgeStyle" },

    "dependencies": { "$ref": "#/$defs/Dependencies" },
    "devDependencies": { "$ref": "#/$defs/Dependencies" },
    "peerDependencies": { "$ref": "#/$defs/Dependencies" },
    "statusBadges": { "$ref": "#/$defs/StatusBadges" }
  },

  "$defs": {
    "Position": {
      "type": "string",
      "enum": ["left", "right", "center", "justify"]
    },

    "OutputFormat": {
      "type": "string",
      "enum": ["json", "markdown"]
    },

    "BadgeStyle": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },

        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": { "type": "string" },
        "showHeader": { "type": "boolean" },
        "position": { "$ref": "#/$defs/Position" }
      }
    },

    "DependencyItem": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "message": { "type": "string" },

        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },

        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "Dependencies": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/Layout" },
        "badgeStyle": { "$ref": "#/$defs/BadgeStyle" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/DependencyItem" }
        }
      }
    },

    "GitHubStatusBadge": {
      "type": "object",
      "required": ["name", "metric", "user", "repo"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "github" },
        "metric": {
          "type": "string",
          "enum": ["stars", "license", "release", "actions"]
        },
        "user": { "type": "string" },
        "repo": { "type": "string" },
        "workflow": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },

        "message": { "type": "string" },

        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },

        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "DockerHubStatusBadge": {
      "type": "object",
      "required": ["name", "metric", "user", "image"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "docker" },
        "metric": {
          "type": "string",
          "enum": ["pulls", "stars", "v"]
        },
        "user": { "type": "string" },
        "image": { "type": "string" },
        "tag": { "type": ["string", "null"] },

        "message": { "type": "string" },

        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },

        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "CodecovStatusBadge": {
      "type": "object",
      "required": ["name", "user", "repo"],
      "additionalProperties": false,
      "properties": {
        "token": { "type": "string" },
        "name": { "const": "codecov" },
        "user": { "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "flag": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },

        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "TileStatusBadge": {
      "type": "object",
      "required": ["name", "message", "label"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "tile" },
        "message": { "type": "string" },
        "label": { "type": "string" },
        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "SocketStatusBadge": {
      "type": "object",
      "required": ["name", "package"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "socket" },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "message": { "type": "string" },
        "color": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "labelColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "isError": { "type": "boolean" },
        "namedLogo": { "type": "string" },
        "logoSvg": { "type": "string" },
        "logoColor": {
          "type": "string",
          "pattern": "^([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex color code without the # prefix"
        },
        "logoWidth": { "type": "number" },
        "style": {
          "enum": ["flat", "flat-square", "plastic", "for-the-badge", "social"]
        },
        "cacheSeconds": { "type": "number" },
        "link": { "type": "string" }
      }
    },

    "StatusBadgeItem": {
      "oneOf": [
        { "$ref": "#/$defs/GitHubStatusBadge" },
        { "$ref": "#/$defs/DockerHubStatusBadge" },
        { "$ref": "#/$defs/CodecovStatusBadge" },
        { "$ref": "#/$defs/TileStatusBadge" },
        { "$ref": "#/$defs/SocketStatusBadge" }
      ]
    },

    "StatusBadges": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/Layout" },
        "badgeStyle": { "$ref": "#/$defs/BadgeStyle" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/StatusBadgeItem" }
        }
      }
    }
  }
}
